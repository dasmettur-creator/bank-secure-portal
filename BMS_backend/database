from mysql.connector import connect

def check_table(level,uid,upwd):
    my_con=connect(host="127.0.0.1",user="root",passwd="Mangalesh@2009",database='__BOP__')
    my_cur=my_con.cursor()
    table_name = f"{level}_details"
    id_col = f"{level}Id"
    pwd_col = f"{level}Pwd"
    try:
        query = f"SELECT * FROM {table_name} WHERE {id_col} = %s AND {pwd_col} = %s"
        my_cur.execute(query, (uid, upwd))
        result = my_cur.fetchone()
        my_cur.close()
        my_con.close()
    except Exception:
        return False
    
    if result:
        return True, level
    return False


